    },
    {
      "id": "picker.default",
      "title": "Month picker",
      "route": "/"
    },
    {
      "id": "picker.first-year",
      "title": "First year with data",
      "route": "/"
    },
    {
      "id": "picker.es",
      "title": "Month picker (Spanish)",
      "route": "/"
    },
    {
      "id": "picker.one-month",
      "title": "Only one month of data",
      "route": "/"
    }
  ],
  "transitions": [
    {
      "from": "header.default",
      "to": "picker.default",
      "label": "Tap the month title"
    },
    {
      "from": "picker.default",
      "to": "picker.first-year",
      "label": "Tap Previous year until the first year with data"
