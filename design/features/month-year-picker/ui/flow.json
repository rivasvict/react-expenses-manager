      "label": "Tap a month, the close button or the scrim"
    },
    {
      "from": "header.default",
      "to": "picker.es",
      "label": "Same, with the app in Spanish"
    },
    {
      "from": "header.default",
      "to": "picker.one-month",
      "label": "Same, with data in a single month"
    }
  ]
