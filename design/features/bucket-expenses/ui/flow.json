{
  "screens": [
    {
      "id": "bucket-list",
      "title": "Buckets",
      "route": "/buckets",
      "external": true
    },
    {
      "id": "bucket.default",
      "title": "Edit bucket",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "bucket.es",
      "title": "Edit bucket (Spanish)",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "bucket.ahead",
      "title": "Edit bucket, ahead of pace",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "bucket.empty",
      "title": "Edit bucket, nothing spent",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "allowance-sheet.default",
      "title": "Allowance sheet",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "allowance-sheet.error",
      "title": "Allowance sheet, invalid value",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "settings",
      "title": "Settings",
      "route": "/settings",
      "external": true
    },
    {
      "id": "settings-view.default",
      "title": "Settings with the Weekly spending row",
      "route": "/settings"
    },
    {
      "id": "settings-view.es",
      "title": "Settings with the Weekly spending row (Spanish)",
      "route": "/settings"
    },
    {
      "id": "weekly-sheet.default",
      "title": "Weekly spending sheet",
      "route": "/settings"
    },
    {
      "id": "weekly-sheet.es",
      "title": "Weekly spending sheet (Spanish)",
      "route": "/settings"
    },
    {
      "id": "bucket.bars",
      "title": "Edit bucket, weekly bars",
      "route": "/edit-bucket/eating-out"
    },
    {
      "id": "bucket.line",
      "title": "Edit bucket, month line",
      "route": "/edit-bucket/eating-out"
    }
  ],
  "transitions": [
    {
      "from": "bucket-list",
      "to": "bucket.default",
      "label": "Tap a bucket"
    },
    {
      "from": "bucket.default",
      "to": "bucket.es",
      "label": "Language set to Spanish"
    },
    {
      "from": "bucket.default",
      "to": "bucket.ahead",
      "label": "Spending is ahead of the pace"
    },
    {
      "from": "bucket.default",
      "to": "bucket.empty",
      "label": "Nothing spent in the month yet"
    },
    {
      "from": "bucket.default",
      "to": "allowance-sheet.default",
      "label": "Tap Edit"
    },
    {
      "from": "allowance-sheet.default",
      "to": "allowance-sheet.error",
      "label": "Submit 0"
    },
    {
      "from": "allowance-sheet.default",
      "to": "bucket.default",
      "label": "Submit a valid amount or tap Cancel"
    },
    {
      "from": "bucket.default",
      "to": "bucket-list",
      "label": "Tap Go Back"
    },
    {
      "from": "settings",
      "to": "settings-view.default",
      "label": "Open Settings"
    },
    {
      "from": "settings-view.default",
      "to": "settings-view.es",
      "label": "Language set to Spanish"
    },
    {
      "from": "settings-view.default",
      "to": "weekly-sheet.default",
      "label": "Tap Weekly spending"
    },
    {
      "from": "weekly-sheet.default",
      "to": "weekly-sheet.es",
      "label": "Language set to Spanish"
    },
    {
      "from": "weekly-sheet.default",
      "to": "bucket.bars",
      "label": "Pick Weekly bars, then open a bucket"
    },
    {
      "from": "weekly-sheet.default",
      "to": "bucket.line",
      "label": "Pick Month line, then open a bucket"
    },
    {
      "from": "weekly-sheet.default",
      "to": "settings-view.default",
      "label": "Pick Week rows or tap Close"
    }
  ]
}