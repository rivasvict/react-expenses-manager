    },
    {
      "from": "theme-sheet.default",
      "to": "settings.default",
      "label": "Tap Close, the scrim or Escape"
    },
    {
      "from": "theme-sheet.default",
      "to": "settings.light",
      "label": "Scroll, tap Flexoki Light, then Close"
    },
    {
      "from": "settings.es",
      "to": "theme-sheet.es",
      "label": "Tap Tema"
    },
    {
      "from": "preferences.default",
      "to": "preferences.picked",
      "label": "Tap All Hallows in the strip"
    },
    {
      "from": "preferences.picked",
