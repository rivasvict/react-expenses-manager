        {
          "click": "button:text-is(\"Internet\")"
        },
        {
          "click": "button:text-is(\"Eating out\")"
        },
        {
          "click": "button:text-is(\"Food\")"
        },
        {
          "click": "button:text-is(\"Health\")"
        },
        {
          "fill": [
            "input[name=\"customCategory\"]",
            "Pet food"
          ]
        },
        {
          "click": "button:text-is(\"Add\")"
        },
        {
          "click": "button:text-is(\"Next\")"
        },
        {
          "click": "button:text-is(\"Salary\")"
        },
        {
          "click": "button:text-is(\"Deposit\")"
        },
        {
          "fill": [
            "input[name=\"customCategory\"]",
            "Freelance"
          ]
        },
        {
          "click": "button:text-is(\"Add\")"
        },
        {
          "click": "button:text-is(\"Next\")"
        },
        {
          "click": "role=checkbox[name=\"House (Rent)\"]"
        },
        {
          "fill": [
            "input[name=\"limit-House (Rent)\"]",
            "1200.00"
          ]
        },
        {
          "blur": true
        },
        {
          "click": "role=checkbox[name=\"Eating out\"]"
        },
        {
          "fill": [
            "input[name=\"limit-Eating out\"]",
            "300.00"
          ]
        },
        {
          "blur": true
        },
        {
          "click": "role=checkbox[name=\"Food\"]"
        },
        {
          "fill": [
            "input[name=\"limit-Food\"]",
            "450.00"
          ]
        },
        {
          "blur": true
        },
        {
