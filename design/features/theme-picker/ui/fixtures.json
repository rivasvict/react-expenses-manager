        "width": 375,
        "height": 720
      },
      "localStorage": {
        "everShowDataDisclaimer": "0",
        "settings.language": "en"
      },
      "actions": [
        {
          "click": "button:text-is(\"Next\")"
        },
        {
          "click": "button:text-is(\"House (Rent)\")"
        },
        {
          "click": "button:text-is(\"Transportation\")"
        },
        {
          "click": "button:text-is(\"Subscriptions\")"
